# Copy this file to .env and paste your OpenAI API key.
# Never commit the real .env file to GitHub.
OPENAI_API_KEY=sk-proj-REPLACE_ME

# Optional default. The UI can override this per run.
OPENAI_MODEL=gpt-5.6

# v029 lightweight Discussion uplift defaults
UPLIFT_SMALL_MODEL=gpt-5.4-nano
UPLIFT_REFERENCE_MODEL=gpt-5.4-mini

# v045 Discussion Hub. v043-derived Balanced Compiler + all downstream agents.
# graph_native_6agents_balanced: Balanced Compiler + parallel Evidence/Logic/Target + conditional Assumption + conditional Judge
# graph_native_5agents_pilot: v037 rollback mode
# graph_native_multi_agent: v036 rollback mode
# legacy_single_pass: previous one-call structured prompt
DISCUSSION_ARCHITECTURE=graph_native_6agents_balanced

# Set 0 to disable only the conditional Judge.
DISCUSSION_JUDGE_ENABLED=1
DISCUSSION_JUDGE_CONFIDENCE_THRESHOLD=0.65

# Long-document graph safeguards.
DISCUSSION_MAX_NODES_PER_CHUNK=32
DISCUSSION_MAX_EDGES_PER_CHUNK=72
DISCUSSION_MAX_DOCUMENT_NODES=120
DISCUSSION_MAX_DOCUMENT_EDGES=260
DISCUSSION_NODE_DEDUP_THRESHOLD=0.96
